# apps/api configuration (design.md A9). Copy to apps/api/.env for local development (git-ignored) and set the
# same keys in the Vercel project env for preview and production. Never commit values.
# src/config.ts validates these at start-up and names anything missing or invalid.

# ── Required: email (Resend; sender verified on biyani.xyz, design.md A10) ──
RESEND_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=

# ── Required: providers (Neon Postgres and Upstash Redis via the Vercel Marketplace inject their own) ──
AI_API_KEY=                        # NVIDIA API catalog key (nvapi-…), or another OpenAI-compatible provider's
DATABASE_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── Optional: limits and retention (defaults shown in comments) ──
# Delete stored contact messages older than this many days. The privacy policy states this value.
CONTACT_RETENTION_DAYS=            # 365
CONTACT_RATE_LIMIT_PER_IP_PER_HOUR= # 5
AI_RATE_LIMIT_PER_IP_PER_HOUR=     # 30
AI_MAX_OUTPUT_TOKENS=              # 1200
AI_DAILY_BUDGET_USD=               # 2
AI_BASE_URL=                       # https://integrate.api.nvidia.com/v1
AI_MODEL=                          # meta/llama-3.3-70b-instruct
AI_SUGGESTION_MODEL=               # meta/llama-3.1-8b-instruct

# ── Optional: CORS (comma-separated; `*` within a label outside production) ──
ALLOWED_ORIGINS=                   # https://vishal.biyani.xyz
