    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@upstash/redis": "^1.39.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^9",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^24",
    "eslint": "^9",
    "globals": "^17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=24"
  }
