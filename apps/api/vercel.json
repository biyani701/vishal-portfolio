{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm run build && pnpm run migrate",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- . ../../package.json ../../pnpm-lock.yaml ../../pnpm-workspace.yaml",
  "crons": [
    { "path": "/cron/ai-models", "schedule": "0 3 * * *" },
    { "path": "/cron/contact", "schedule": "30 3 * * *" }
  ]
}
