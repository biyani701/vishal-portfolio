{
  "name": "hub",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "biyani.xyz: the front door to the sites under the domain (openspec add-biyani-hub).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/render.ts",
    "preview": "vite preview --port 4174 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "smoke": "node scripts/smoke.ts"
  },
  "dependencies": {
    "@vishal/content-guard": "workspace:*",
    "@vishal/design": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4",
    "@testing-library/jest-dom": "^7",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19",
    "axe-core": "^4",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7",
    "globals": "^17",
    "jsdom": "^30",
    "tailwindcss": "^4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8",
    "vite": "^8.3.1",
    "vitest": "^5"
  }
}
