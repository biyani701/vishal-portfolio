# Client build configuration for apps/web. Every VITE_* value is PUBLIC (inlined into the bundle): never put secrets here.
# Copy to .env.local for local production builds; CI and Vercel set these in their environment.
# public/runtime-config.js can override them after deploy (keys: API_BASE_URL, ANALYTICS_API_URL).

# Required: apps/api base URL (contact, Ask). Production: https://api.vishal.biyani.xyz
VITE_API_BASE_URL=
# Optional: analytics endpoint; analytics is off when unset.
VITE_ANALYTICS_API_URL=
