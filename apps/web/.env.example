# Client build configuration for apps/web. Every VITE_* value is PUBLIC (inlined into the bundle): never put secrets here.
# Copy to .env.local for local production builds; CI and Vercel set these in their environment.
# public/runtime-config.js can override them after deploy (keys: API_BASE_URL, AUTH_SERVER_URL, CLIENT_ID, AUTH_PROVIDERS, ANALYTICS_API_URL).

# Required: apps/api base URL (contact, Ask). Production: https://api.vishal.biyani.xyz
VITE_API_BASE_URL=
# Required: apps/auth-server (Auth.js) base URL.
VITE_AUTH_SERVER_URL=
# Optional: OAuth client id registered with the auth server (default: portfolio).
VITE_AUTH_CLIENT_ID=
# Optional: comma-separated sign-in providers configured on the auth server (default: github,google).
VITE_AUTH_PROVIDERS=
# Optional: analytics endpoint; analytics is off when unset.
VITE_ANALYTICS_API_URL=
